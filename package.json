{
  "name": "youtube-downloader-bot-serverless",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Telegram Serverless request UI for an external YouTube download worker",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "check": "node --check tgcloud/schema.js && node --check tgcloud/handlers/message.js",
